{
  "terminal-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/security_gate.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "code-quality-auditor": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "git status --short",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
